    <!-- PIT Mutation Testing Profile for Evaluation -->
    <!-- Add this inside <profiles> section of jgrapht/pom.xml -->
    <!-- NOTE: JGraphT uses JPMS — requires --add-opens for all sampled packages -->
    <profile>
      <id>pitest</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <executions>
              <execution>
                <id>default-test</id>
                <configuration>
                  <useModulePath>false</useModulePath>
                  <includes>
                    <include>**/*Test.java</include>
                  </includes>
                  <excludes>
                    <exclude>**/perf/**</exclude>
                    <exclude>**/FastTestSuite.java</exclude>
                  </excludes>
                  <excludedGroups>slow,optional</excludedGroups>
                  <properties>
                    <configurationParameters>
                      junit.jupiter.execution.parallel.enabled = false
                      junit.jupiter.testinstance.lifecycle.default = per_method
                    </configurationParameters>
                  </properties>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.pitest</groupId>
            <artifactId>pitest-maven</artifactId>
            <version>1.17.4</version>
            <dependencies>
              <dependency>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-junit5-plugin</artifactId>
                <version>1.2.1</version>
              </dependency>
            </dependencies>
            <configuration>
              <!-- targetClasses and targetTests are overridden via CLI per-class -->
              <targetClasses>
                <param>org.jgrapht.*</param>
              </targetClasses>
              <targetTests>
                <param>org.jgrapht.*</param>
              </targetTests>
              <outputFormats>
                <outputFormat>XML</outputFormat>
              </outputFormats>
              <fullMutationMatrix>true</fullMutationMatrix>
              <mutators>
                <mutator>DEFAULTS</mutator>
              </mutators>
              <timestampedReports>false</timestampedReports>
              <threads>4</threads>
              <timeoutFactor>2.0</timeoutFactor>
              <timeoutConstant>10000</timeoutConstant>
              <jvmArgs>
                <jvmArg>-Xmx2g</jvmArg>
                <jvmArg>--add-opens=org.jgrapht.core/org.jgrapht=ALL-UNNAMED</jvmArg>
                <jvmArg>--add-opens=org.jgrapht.core/org.jgrapht.alg.clique=ALL-UNNAMED</jvmArg>
                <jvmArg>--add-opens=org.jgrapht.core/org.jgrapht.alg.clustering=ALL-UNNAMED</jvmArg>
                <jvmArg>--add-opens=org.jgrapht.core/org.jgrapht.alg.color=ALL-UNNAMED</jvmArg>
                <jvmArg>--add-opens=org.jgrapht.core/org.jgrapht.alg.connectivity=ALL-UNNAMED</jvmArg>
                <jvmArg>--add-opens=org.jgrapht.core/org.jgrapht.alg.cycle=ALL-UNNAMED</jvmArg>
                <jvmArg>--add-opens=org.jgrapht.core/org.jgrapht.alg.drawing.model=ALL-UNNAMED</jvmArg>
                <jvmArg>--add-opens=org.jgrapht.core/org.jgrapht.alg.flow=ALL-UNNAMED</jvmArg>
                <jvmArg>--add-opens=org.jgrapht.core/org.jgrapht.alg.isomorphism=ALL-UNNAMED</jvmArg>
                <jvmArg>--add-opens=org.jgrapht.core/org.jgrapht.alg.lca=ALL-UNNAMED</jvmArg>
                <jvmArg>--add-opens=org.jgrapht.core/org.jgrapht.alg.linkprediction=ALL-UNNAMED</jvmArg>
                <jvmArg>--add-opens=org.jgrapht.core/org.jgrapht.alg.matching.blossom.v5=ALL-UNNAMED</jvmArg>
                <jvmArg>--add-opens=org.jgrapht.core/org.jgrapht.alg.scoring=ALL-UNNAMED</jvmArg>
                <jvmArg>--add-opens=org.jgrapht.core/org.jgrapht.alg.shortestpath=ALL-UNNAMED</jvmArg>
                <jvmArg>--add-opens=org.jgrapht.core/org.jgrapht.alg.spanning=ALL-UNNAMED</jvmArg>
                <jvmArg>--add-opens=org.jgrapht.core/org.jgrapht.alg.tour=ALL-UNNAMED</jvmArg>
                <jvmArg>--add-opens=org.jgrapht.core/org.jgrapht.alg.util=ALL-UNNAMED</jvmArg>
                <jvmArg>--add-opens=org.jgrapht.core/org.jgrapht.alg.vertexcover=ALL-UNNAMED</jvmArg>
                <jvmArg>--add-opens=org.jgrapht.core/org.jgrapht.generate.netgen=ALL-UNNAMED</jvmArg>
                <jvmArg>--add-opens=org.jgrapht.core/org.jgrapht.graph.specifics=ALL-UNNAMED</jvmArg>
                <jvmArg>--add-opens=org.jgrapht.core/org.jgrapht.alg.interfaces=ALL-UNNAMED</jvmArg>
                <jvmArg>--add-opens=org.jgrapht.core/org.jgrapht.graph=ALL-UNNAMED</jvmArg>
                <jvmArg>--add-opens=org.jgrapht.core/org.jgrapht.util=ALL-UNNAMED</jvmArg>
                <jvmArg>--add-opens=org.jgrapht.core/org.jgrapht.alg.matching=ALL-UNNAMED</jvmArg>
                <jvmArg>--add-opens=org.jgrapht.core/org.jgrapht.generate=ALL-UNNAMED</jvmArg>
                <jvmArg>--add-opens=org.jgrapht.core/org.jgrapht.event=ALL-UNNAMED</jvmArg>
                <jvmArg>--add-opens=org.jgrapht.core/org.jgrapht.traverse=ALL-UNNAMED</jvmArg>
                <jvmArg>--add-opens=org.jgrapht.core/org.jgrapht.graph.builder=ALL-UNNAMED</jvmArg>
                <jvmArg>--add-opens=org.jgrapht.core/org.jgrapht.alg.util.extension=ALL-UNNAMED</jvmArg>
                <jvmArg>--add-opens=org.jgrapht.core/org.jgrapht.alg.flow.mincost=ALL-UNNAMED</jvmArg>
              </jvmArgs>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
