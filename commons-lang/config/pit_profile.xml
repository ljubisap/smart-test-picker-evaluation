    <!-- PIT Mutation Testing Profile for Evaluation -->
    <!-- Add this inside <profiles> section of commons-lang pom.xml -->
    <profile>
      <id>pitest</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.pitest</groupId>
            <artifactId>pitest-maven</artifactId>
            <version>1.17.4</version>
            <dependencies>
              <dependency>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-junit5-plugin</artifactId>
                <version>1.2.1</version>
              </dependency>
            </dependencies>
            <configuration>
              <!-- targetClasses and targetTests are overridden via CLI per-class -->
              <targetClasses>
                <param>org.apache.commons.lang3.*</param>
              </targetClasses>
              <targetTests>
                <param>org.apache.commons.lang3.*</param>
              </targetTests>
              <excludedTestClasses>
                <param>org.apache.commons.lang3.builder.CompareToBuilderTest</param>
                <param>org.apache.commons.lang3.builder.EqualsBuilderTest</param>
                <param>org.apache.commons.lang3.builder.EqualsBuilderReflectJreImplementationTest</param>
                <param>org.apache.commons.lang3.builder.HashCodeBuilderAndEqualsBuilderTest</param>
                <param>org.apache.commons.lang3.builder.ReflectionDiffBuilderTest</param>
                <param>org.apache.commons.lang3.builder.ToStringBuilderTest</param>
                <param>org.apache.commons.lang3.SystemPropertiesTest</param>
                <param>org.apache.commons.lang3.exception.UncheckedReflectiveOperationExceptionTest</param>
              </excludedTestClasses>
              <outputFormats>
                <outputFormat>XML</outputFormat>
              </outputFormats>
              <fullMutationMatrix>true</fullMutationMatrix>
              <skipFailingTests>true</skipFailingTests>
              <mutators>
                <mutator>DEFAULTS</mutator>
              </mutators>
              <timestampedReports>false</timestampedReports>
              <threads>4</threads>
              <jvmArgs>
                <jvmArg>-Xmx4g</jvmArg>
                <jvmArg>--add-opens=java.base/java.lang.reflect=ALL-UNNAMED</jvmArg>
                <jvmArg>--add-opens=java.base/java.lang=ALL-UNNAMED</jvmArg>
                <jvmArg>--add-opens=java.base/java.util=ALL-UNNAMED</jvmArg>
                <jvmArg>--add-opens=java.base/java.time=ALL-UNNAMED</jvmArg>
                <jvmArg>--add-opens=java.base/java.time.chrono=ALL-UNNAMED</jvmArg>
                <jvmArg>--add-opens=java.base/java.util.concurrent.atomic=ALL-UNNAMED</jvmArg>
              </jvmArgs>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
