    <!-- Frozen supplementary-study PIT profile; insert inside subject <profiles>. -->
    <profile>
      <id>pitest</id>
      <dependencies>
        <dependency>
          <groupId>junit</groupId>
          <artifactId>junit</artifactId>
          <version>4.13.2</version>
          <scope>test</scope>
        </dependency>
      </dependencies>
      <build>
        <plugins>
          <plugin>
            <groupId>org.pitest</groupId>
            <artifactId>pitest-maven</artifactId>
            <version>1.17.4</version>
            <configuration>
              <targetClasses><param>${pitest.targetClasses}</param></targetClasses>
              <targetTests><param>${pitest.targetTests}</param></targetTests>
              <outputFormats><outputFormat>XML</outputFormat></outputFormats>
              <fullMutationMatrix>true</fullMutationMatrix>
              <skipFailingTests>true</skipFailingTests>
              <mutators><mutator>DEFAULTS</mutator></mutators>
              <timestampedReports>false</timestampedReports>
              <threads>8</threads>
              <jvmArgs><jvmArg>-XX:ActiveProcessorCount=8</jvmArg><jvmArg>-Xmx4g</jvmArg></jvmArgs>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
